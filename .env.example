# Supabase Postgres, session mode (direct connection or the session pooler on
# port 5432). The transaction pooler on 6543 breaks LISTEN/NOTIFY.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Public HTTPS origin Twilio can reach (an ngrok URL in development).
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# Long random strings, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=
CALL_TOKEN_SECRET=

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15550000000

# Voice model. Gemini's free tier (key from https://aistudio.google.com/apikey) lets
# Google use requests to improve its products, so send it test data only.
VOICE_PROVIDER=gemini
GEMINI_API_KEY=
# Or: VOICE_PROVIDER=anthropic with ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=
# Blank uses the provider default: gemini-3.5-flash-lite (effort minimal) or
# claude-sonnet-5-5 (effort low). gemini-3.8-flash took 43 s to start replying in testing.
# VOICE_MODEL=
# VOICE_EFFORT=
